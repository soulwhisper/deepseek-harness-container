# Copy to .env and replace every value. Never commit the filled file.
# The private network must already exist:
#   docker network create --subnet 172.30.80.0/24 dsh-private
# The edge joins it at 172.30.80.2 and forwards to the chosen app IP.

DSH_WEB_IMAGE=ghcr.io/soulwhisper/dsh-web:0.2.1-rc.2
DSH_WEB_IP=172.30.80.3
DSH_PUBLIC_URL=https://dsh.example.net
DSH_TRUSTED_HOST=dsh.example.net
DSH_SSO_ALLOWED_UIDS=replace-with-the-stable-authentik-uid
DSH_SSO_TRUSTED_PROXY_CIDRS=172.30.80.2/32

DSH_TAVERN_IMAGE=ghcr.io/soulwhisper/dsh-tavern:3.0
DSH_TAVERN_IP=172.30.80.4
DSH_TAVERN_PUBLIC_URL=https://tavern.example.net
DSH_TAVERN_TRUSTED_HOST=tavern.example.net
DSH_TAVERN_SSO_ALLOWED_UIDS=replace-with-the-stable-authentik-uid
DSH_TAVERN_SSO_TRUSTED_PROXY_CIDRS=172.30.80.2/32
