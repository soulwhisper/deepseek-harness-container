{
  "name": "@soulwhisper/dsh-mobile-layout",
  "version": "0.1.0",
  "description": "Minimal mobile layout switch for the DSH Web client: drawer, safe area and keyboard viewport, no portal or remote access",
  "type": "module",
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.0-rc.6 <0.3.0-0"
  },
  "engines": {
    "node": ">=24"
  }
}
