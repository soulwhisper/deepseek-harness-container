{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>soulwhisper/renovate-config"
  ],
  "ignorePaths": [
    "docs/**",
    "deploy/**"
  ],
  "lockFileMaintenance": {
    "enabled": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "DSH npm version pinned in versions.json",
      "managerFilePatterns": [
        "/(^|/)versions\\.json$/"
      ],
      "matchStrings": [
        "\"dsh\": \\{\\s*\"version\": \"(?<currentValue>[^\"]+)\","
      ],
      "depNameTemplate": "@deepseek-ai/dsh",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Tavern upstream tag pinned in versions.json",
      "managerFilePatterns": [
        "/(^|/)versions\\.json$/"
      ],
      "matchStrings": [
        "\"tavern\": \\{\\s*\"repository\": \"[^\"]+\",\\s*\"version\": \"(?<currentValue>[^\"]+)\","
      ],
      "depNameTemplate": "flizzywine/dsh-tavern",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "dshmarket version pinned in versions.json (exact-hash patch must be rebased)",
      "managerFilePatterns": [
        "/(^|/)versions\\.json$/"
      ],
      "matchStrings": [
        "\"market\": \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "dshmarket",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "DSH Web upstream: versions.json, source commit, release tag, runtime lock and docs move together. Human merges.",
      "matchPackageNames": [
        "/^@deepseek-ai\\//"
      ],
      "groupName": "dsh-web-upstream",
      "addLabels": [
        "area/dsh"
      ],
      "semanticCommitType": "release",
      "semanticCommitScope": "dsh-web",
      "commitMessageExtra": "( {{currentVersion}} → {{newVersion}} )",
      "ignoreUnstable": false,
      "automerge": false,
      "platformAutomerge": false
    },
    {
      "description": "Tavern upstream: tag, source commit, route hash, profile lock and docs move together. Human merges.",
      "matchPackageNames": [
        "flizzywine/dsh-tavern"
      ],
      "groupName": "dsh-tavern-upstream",
      "addLabels": [
        "area/dsh"
      ],
      "semanticCommitType": "release",
      "semanticCommitScope": "dsh-tavern",
      "commitMessageExtra": "( {{currentVersion}} → {{newVersion}} )",
      "automerge": false,
      "platformAutomerge": false
    },
    {
      "description": "dshmarket is patched by exact artifact hash. A bump opens a PR that must be fixed by rebasing the patch, never by weakening the hash.",
      "matchPackageNames": [
        "dshmarket"
      ],
      "groupName": "dsh-market",
      "addLabels": [
        "area/dsh"
      ],
      "semanticCommitType": "release",
      "semanticCommitScope": "dsh-market",
      "commitMessageExtra": "( {{currentVersion}} → {{newVersion}} )",
      "automerge": false,
      "platformAutomerge": false
    },
    {
      "description": "GitHub Actions stay SHA-pinned; update digest plus version comment together.",
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true,
      "addLabels": [
        "area/github"
      ],
      "automerge": false,
      "platformAutomerge": false
    },
    {
      "description": "Node digest, pnpm and Dockerfile syntax are coupled build pins. Update deliberately with the image and locks.",
      "matchFileNames": [
        "docker/Dockerfile"
      ],
      "enabled": false
    },
    {
      "description": "Profile locks are generated by the Docker profile-locks target and must never be updated independently.",
      "matchFileNames": [
        "docker/profiles/**"
      ],
      "enabled": false
    },
    {
      "description": "DSH is a developer preview. Every dependency update, including patch and digest updates, requires human review and manual merge.",
      "matchPackageNames": [
        "*"
      ],
      "automerge": false,
      "platformAutomerge": false,
      "addLabels": [
        "area/renovate",
        "review/required"
      ]
    }
  ],
  "prBodyNotes": [
    "DSH is a developer preview. Verify that the version change also updates the source commit, exact-hash patch anchors, locks, release tag and documentation. A version-only update is not mergeable."
  ]
}
